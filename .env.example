# Copy to .env and fill in. Never commit .env.
# Generate key pairs in Kalshi profile settings -> API Keys. The private key is shown once.
# Make a SEPARATE key for demo (https://demo.kalshi.co) and for production (https://kalshi.com).
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-demo.pem
CONFIRM_LIVE=no
ALERT_WEBHOOK_URL=
