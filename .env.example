# Copy to .env and fill in. Never commit .env. Save private keys as *.pem files; .gitignore covers them.
# Both keys live here side by side. Demo commands read only the demo key; --live reads only the live key.
KALSHI_ENV=demo

# Demo key: https://demo.kalshi.co -> profile -> API keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-demo.pem

# Production key: https://kalshi.com -> profile -> API keys. Used only with `--live` AND CONFIRM_LIVE=yes.
KALSHI_LIVE_API_KEY_ID=
KALSHI_LIVE_PRIVATE_KEY_PATH=./kalshi-live.pem

# Must be exactly `yes` for --live to work. Leave `no` until you intend to trade real money.
CONFIRM_LIVE=no

# Optional Slack/Discord-style webhook for halts and critical alerts.
ALERT_WEBHOOK_URL=
